{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.strata.local/plugin-manifest.schema.json",
  "title": "Strata Plugin Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "version", "minimum_host_api", "component", "plugin_types", "capabilities", "resources"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string" },
    "publisher": { "type": "string" },
    "minimum_host_api": { "type": "string" },
    "component": {
      "type": "object",
      "required": ["path", "digest"],
      "properties": {
        "path": { "type": "string" },
        "digest": { "type": "string" },
        "signature": { "type": ["string", "null"] }
      }
    },
    "plugin_types": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["analyzer", "overlay", "view", "transform", "exporter", "connector", "command"] }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "oneOf": [
          { "const": "source.metadata" },
          {
            "type": "object",
            "required": ["source.ranges"],
            "properties": { "source.ranges": { "type": "object", "required": ["max_bytes_per_call"], "properties": { "max_bytes_per_call": { "type": "integer", "minimum": 1 } } } }
          },
          { "const": "analysis.request" },
          { "const": "findings.emit" },
          { "const": "scene.emit" },
          { "const": "state.local" },
          {
            "type": "object",
            "required": ["network"],
            "properties": { "network": { "type": "object", "required": ["domains"], "properties": { "domains": { "type": "array", "items": { "type": "string" } } } } }
          }
        ]
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["memory_bytes", "fuel", "wall_time_ms", "max_output_bytes", "max_concurrent_calls"],
      "properties": {
        "memory_bytes": { "type": "integer", "minimum": 1048576 },
        "fuel": { "type": "integer", "minimum": 1 },
        "wall_time_ms": { "type": "integer", "minimum": 1 },
        "max_output_bytes": { "type": "integer", "minimum": 1 },
        "max_concurrent_calls": { "type": "integer", "minimum": 1 }
      }
    },
    "determinism": { "enum": ["deterministic", "numeric_tolerance", "seeded", "heuristic"] },
    "license": { "type": "string" },
    "parameter_schemas": { "type": "object" },
    "result_schemas": { "type": "object" }
  }
}
