{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.strata.local/evidence.schema.json",
  "title": "Strata Evidence Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "claim", "status", "selection_ids", "provenance_roots", "created_at"],
  "properties": {
    "id": { "type": "string" },
    "claim": { "type": "string", "minLength": 1 },
    "status": { "enum": ["hypothesis", "corroborated", "rejected", "informational"] },
    "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "confidence_basis": { "type": "string" },
    "rationale_markdown": { "type": "string" },
    "selection_ids": { "type": "array", "items": { "type": "string" } },
    "view_frame_ids": { "type": "array", "items": { "type": "string" } },
    "artifact_ids": { "type": "array", "items": { "type": "string" } },
    "provenance_roots": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "created_at": { "type": "string", "format": "date-time" },
    "created_by": { "type": ["string", "null"] },
    "supersedes": { "type": ["string", "null"] }
  }
}
